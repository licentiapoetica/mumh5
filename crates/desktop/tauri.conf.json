{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mumh5",
  "version": "0.2.0",
  "identifier": "dev.f0ck.mumh5",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../../frontend"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../../frontend"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; connect-src ipc: http://ipc.localhost 'self' blob: https: http: ws: wss:; worker-src 'self' blob:; font-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-src https://www.youtube-nocookie.com",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Modern Mumble client",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libssl3",
          "libopus0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
